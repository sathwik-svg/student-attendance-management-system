# =========================================================
# AUTH HELPERS
# =========================================================

def login_required(view):

    @wraps(view)
    def wrapped(*args, **kwargs):

        if "user_id" not in session:

            return jsonify({
                "success": False,
                "error": "Authentication required"
            }), 401

        return view(*args, **kwargs)

    return wrapped


def role_required(*allowed_roles):

    def decorator(view):

        @wraps(view)
        def wrapped(*args, **kwargs):

            if "user_id" not in session:

                return jsonify({
                    "success": False,
                    "error": "Authentication required"
                }), 401

            if session.get("role") not in allowed_roles:

                return jsonify({
                    "success": False,
                    "error": "Access denied"
                }), 403

            return view(*args, **kwargs)

        return wrapped

    return decorator


