@app.route("/api/dashboard/stats")
def dashboard_stats():
    try:
        connection = get_db_connection()

        with connection.cursor() as cursor:

            cursor.execute("SELECT COUNT(*) AS total FROM students")
            students = cursor.fetchone()["total"]

            cursor.execute("SELECT COUNT(*) AS total FROM faculty")
            faculty = cursor.fetchone()["total"]

            cursor.execute("SELECT COUNT(*) AS total FROM subjects")
            subjects = cursor.fetchone()["total"]

            cursor.execute("SELECT COUNT(*) AS total FROM classes")
            classes = cursor.fetchone()["total"]

            cursor.execute("""
                SELECT
                    COUNT(*) AS total,
                    SUM(status = 'PRESENT') AS present
                FROM attendance
            """)
            attendance = cursor.fetchone()

            total_attendance = attendance["total"] or 0
            present = attendance["present"] or 0

            percentage = (
                round((present / total_attendance) * 100, 1)
                if total_attendance
                else 0
            )

            cursor.execute("""
                SELECT
                    al.id,
                    al.action,
                    al.old_status,
                    al.new_status,
                    al.created_at,
                    u.username,
                    u.full_name
                FROM attendance_logs al
                JOIN users u ON u.id = al.user_id
                ORDER BY al.created_at DESC
                LIMIT 8
            """)
            logs = cursor.fetchall()

        connection.close()

        for log in logs:
            if log.get("created_at"):
                log["created_at"] = log["created_at"].isoformat()

        return jsonify({
            "success": True,
            "stats": {
                "students": students,
                "faculty": faculty,
                "subjects": subjects,
                "classes": classes,
                "attendance_percentage": percentage,
                "attendance_records": total_attendance,
                "present_records": present
            },
            "logs": logs
        })

    except Exception as e:
        print("Dashboard database error:", e)

        return jsonify({
            "success": False,
            "error": "Dashboard data unavailable"
        }), 500


